# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your key never gets uploaded.

OPENAI_API_KEY=your-key-here
# Optional, default gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Claude for the Gap Analyser and for picking a company's own site (needs your own key).
# Without these two lines the app uses gpt-4o-mini for both.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Clause classifier from 3A (Hugging Face model id or a local folder)
CLASSIFIER_MODEL=dralsarrani/opp115-bert
# Only needed if the model repo is private
HF_TOKEN=
